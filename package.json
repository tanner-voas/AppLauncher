{
  "name": "app-launcher",
  "version": "0.1.23",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 build.py",
    "test": "node --test tests/*.test.js",
    "serve": "python3 -m http.server 8765 --directory dist",
    "deploy:worker": "npx --yes wrangler@4 deploy",
    "build:partial": "python3 build.py --allow-partial",
    "verify:release": "sh scripts/verify-release.sh"
  }
}
