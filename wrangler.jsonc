{
  // Launch independently from the legacy Ciyan Worker.
  // The Cloudflare Workers Builds project must use this same name.
  "name": "applauncher",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "main": "./worker.js",
  "services": [{ "binding": "PROFILES", "service": "pwa-profiles-api" }, { "binding": "COMMON", "service": "pwa-core-api" }, { "binding": "GIT_MANAGER", "service": "pwa-git-api" }],
  "assets": { "directory": "./dist", "binding": "ASSETS" }
}
